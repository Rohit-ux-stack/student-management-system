# ==============================================================================
# STUDENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your values.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration (Neon / Supabase / any Postgres provider)
# Direct connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres

# CORS — set this to your Vercel frontend URL in production
CORS_ORIGIN=https://your-app.vercel.app

# Supabase Storage Configuration
# Obtain from: Supabase Dashboard > Project Settings > API
# Use the service_role key (not anon) — needed for server-side uploads to bypass RLS
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=student-photos

# Application Host URL
APP_URL=http://localhost:3000
